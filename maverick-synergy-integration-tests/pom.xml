<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.sshtools.hotfixes</groupId>
		<artifactId>maverick-synergy-group</artifactId>
		<version>3.1.6-SNAPSHOT</version>
	</parent>

	<artifactId>maverick-synergy-integration-tests</artifactId>
	<name>Integration Tests</name>
	<description>End-to-end integration tests for the Maverick Synergy SSH API covering connection, authentication, key exchange, and SFTP</description>

	<dependencies>
		<!-- JUnit 5 Jupiter engine (runs @Test methods) -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Required by the VS Code Test Runner to discover JUnit 5 tests -->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- JUnit 4 vintage bridge so JUnit 4 base classes still run -->
		<dependency>
			<groupId>org.junit.vintage</groupId>
			<artifactId>junit-vintage-engine</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Mockito for unit-level mocking inside integration tests -->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- SSH client/server under test -->
		<dependency>
			<groupId>com.sshtools.hotfixes</groupId>
			<artifactId>maverick-synergy-client</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.sshtools.hotfixes</groupId>
			<artifactId>maverick-synergy-server</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Crypto provider -->
		<dependency>
			<groupId>com.sshtools.hotfixes</groupId>
			<artifactId>maverick-bc</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Virtual filesystem (for SFTP server-side) -->
		<dependency>
			<groupId>com.sshtools.hotfixes</groupId>
			<artifactId>maverick-virtual-filesystem</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Shared test utilities (MockContext etc.) -->
		<dependency>
			<groupId>com.sshtools.hotfixes</groupId>
			<artifactId>maverick-base-tests</artifactId>
			<version>${project.version}</version>
			<classifier>tests</classifier>
			<scope>test</scope>
		</dependency>
		<!-- Logging (avoid silent failures in tests) -->
		<dependency>
			<groupId>com.sshtools.hotfixes</groupId>
			<artifactId>maverick-logging</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Run unit tests (classes ending in Test); disable module path so
			     the classpath-based JUnit Platform launcher works correctly -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<useModulePath>false</useModulePath>
					<excludes>
						<exclude>**/*IT.java</exclude>
					</excludes>
				</configuration>
			</plugin>
			<!-- Run integration tests (classes ending in IT) during integration-test phase -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.5.3</version>
				<configuration>
					<useModulePath>false</useModulePath>
					<includes>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- JaCoCo: instrument classes and emit per-module report -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
			</plugin>
			<!-- Skip deployment of this test-only module -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>2.7</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<!-- Skip Javadoc for test-only module -->
			<plugin>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<!-- Skip license header check for test sources -->
			<plugin>
				<groupId>com.mycila</groupId>
				<artifactId>license-maven-plugin</artifactId>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
